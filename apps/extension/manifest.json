{
  "manifest_version": 3,
  "name": "Nicelist — Add to Wishlist",
  "version": "0.1.0",
  "description": "Add the product you are viewing to your Nicelist wishlist without spoiling surprises.",
  "key": "",
  "permissions": ["activeTab", "scripting", "storage", "identity"],
  "host_permissions": [
    "https://*.amazonaws.com/*",
    "https://*.amazoncognito.com/*"
  ],
  "action": {
    "default_title": "Add to Nicelist",
    "default_popup": "popup.html"
  }
}
